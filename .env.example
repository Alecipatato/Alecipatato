# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# `.env.local` n'est JAMAIS envoyé sur Git.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez jamais de secret.

# --- Domaine (phase 1) -------------------------------------------------------
# Domaine principal de la plateforme. En local : localhost:3000
# (les boutiques sont alors sur http://<sous-domaine>.localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Nom affiché de la plateforme (provisoire : « Kreo »)
NEXT_PUBLIC_PLATFORM_NAME=Kreo

# --- Supabase (phase 1) — Project Settings > API ----------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (sb_publishable_... ou ancienne clé « anon »)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_... ou ancienne « service_role ») — serveur uniquement
SUPABASE_SECRET_KEY=

# --- Anthropic / Claude (phase 2) — https://platform.claude.com ---------------
# Sans cette clé, le formulaire de création affiche « génération non configurée ».
ANTHROPIC_API_KEY=
# Même clé sous un autre nom, si l'hébergeur réserve les noms « ANTHROPIC_… » (environnement cloud de développement).
KREO_ANTHROPIC_API_KEY=

# --- CJ Dropshipping (phases 3 et 6) — Apps > API (ou My CJ > Authorization > API) ---
# Sans clé, l'IA crée des produits d'exemple.
CJ_API_KEY=
# Phase 6 : transmission des commandes payées à CJ. Laisser à false tant que l'adaptateur
# n'a pas été validé avec votre compte CJ : à true, de VRAIES commandes sont créées chez CJ.
CJ_ORDERS_ENABLED=false
# Paiement automatique des commandes avec le solde du portefeuille CJ (USD). Sinon : paiement manuel chez CJ.
CJ_AUTO_PAY=false
# Commandes « sandbox » chez CJ (aucun vrai débit). Mettre false seulement pour passer aux vraies commandes.
CJ_SANDBOX=true
# Délai minimum entre deux appels à CJ, en millisecondes (1100 par défaut). La limite de votre compte
# est affichée par GET /setting/get (qpsLimit) ; ne réduire que si elle le permet.
CJ_MIN_INTERVAL_MS=

# --- Stripe — clés TEST uniquement (sk_test_..., pk_test_...) (phase 5) -----
# Une clé sk_live_ est refusée tant que STRIPE_ALLOW_LIVE n'est pas à "true".
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret(s) de signature des webhooks (whsec_...). Si vous avez deux endpoints
# (plateforme + comptes connectés), mettez les deux séparés par une virgule.
STRIPE_WEBHOOK_SECRET=
# Mettre à false tant que Stripe Tax n'est pas configuré dans le tableau de bord Stripe.
STRIPE_AUTOMATIC_TAX=true
# Secret des tâches planifiées (/api/cron/payouts, /api/cron/orders, /api/cron/sync-products) :
# une longue chaîne aléatoire.
CRON_SECRET=

# --- Domaines personnalisés : Cloudflare for SaaS (phase 11) -----------------
# Jeton API avec la permission « SSL and Certificates: Edit » sur la zone de la plateforme.
CLOUDFLARE_API_TOKEN=
# Identifiant de la zone (onglet Overview du domaine principal dans Cloudflare).
CLOUDFLARE_ZONE_ID=
# Cible CNAME que les clients doivent utiliser (ex. stores.mondomaine.com, déclaré comme « fallback origin »).
CLOUDFLARE_CNAME_TARGET=

# --- Resend (phases 6-7) -----------------------------------------------------
RESEND_API_KEY=
# Expéditeur des courriels (domaine vérifié dans Resend), ex. "Kreo <noreply@mondomaine.com>"
EMAIL_FROM=
# Adresse qui reçoit les alertes admin (ex. commande CJ échouée)
ADMIN_ALERT_EMAIL=

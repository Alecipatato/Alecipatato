# Copiez ce fichier en ".env" puis remplissez-le. Ne partagez JAMAIS le fichier .env.

# --- Alpaca (https://app.alpaca.markets → API Keys) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# "iex" pour un compte gratuit, "sip" si vous avez l'abonnement données
ALPACA_DATA_FEED=iex

# --- Mode : "paper" (argent fictif, recommandé) ou "live" (ARGENT RÉEL) ---
# Attention : les clés paper et live sont différentes chez Alpaca.
TRADING_MODE=paper
# Pour le mode live, recopiez exactement : J'ACCEPTE LES RISQUES
LIVE_CONFIRM=

# --- Claude (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Garde-fous (non modifiables depuis l'interface) ---
MAX_AMOUNT_PER_TRADE=1000
MAX_DAILY_LOSS_PCT=3
MAX_BOT_POSITIONS=3

# --- Serveur ---
PORT=3000
# 127.0.0.1 = accessible uniquement depuis votre ordinateur
HOST=127.0.0.1
# Mot de passe de l'interface (fortement conseillé si HOST n'est pas 127.0.0.1)
APP_PASSWORD=
